GSH_VERSION=dev
GSH_HOSTNAME=saves.stevenpwlk.fr

# Volume confirmé sur le NAS. Les données et secrets restent hors du partage SMB public.
GSH_DATA_PATH=/Volume2/gamesavehub/data
# Utiliser un dossier distinct pour le staging. En production, remplacer par
# /Volume2/gamesavehub/letsencrypt-production et retirer ACME_CA_SERVER.
GSH_ACME_PATH=/Volume2/gamesavehub/letsencrypt-staging
GSH_SECRETS_PATH=/Volume2/gamesavehub/secrets

# 18443 public Livebox -> 8443 NAS. Le second mapping sert aux clients LAN sans changer l'URL.
NAS_TLS_PORT=8443
NAS_LAN_TLS_PORT=18443
ACME_EMAIL=pawlak.steven@gmail.com

# Commencer avec le staging puis retirer cette ligne après validation du certificat.
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Verrou de sécurité : ne passer à true qu'après trois cycles A -> B -> A validés.
GSH_ALLOW_HOST_TRANSFER=false
GSH_MAX_ARTIFACT_BYTES=67108864
GSH_MAX_CHUNK_BYTES=4194304
DYNHOST_INTERVAL_SECONDS=300
GSH_RETENTION_LATEST=20
GSH_RETENTION_DAILY=30
GSH_RETENTION_WEEKLY=26
