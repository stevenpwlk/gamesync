<Window x:Class="GameSaveHub.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameSave Hub — Phase 3" Height="720" Width="1040" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#10151B" Foreground="#F3F5F7">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel>
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="GameSave Hub" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="The Planet Crafter — client intégré Phase 3" Foreground="#AEB8C5" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Border Background="#3A2D1B" Padding="10,5" CornerRadius="5" HorizontalAlignment="Right">
          <TextBlock Text="PRÉFLIGHT — ÉCRITURE WGS DÉSACTIVÉE" Foreground="#FFD28C" FontWeight="SemiBold" />
        </Border>
        <Button Content="Actualiser" Click="Refresh_Click" Padding="16,8" Margin="0,8,0,0" HorizontalAlignment="Right" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Margin="0,20,0,18" Padding="15" Background="#19212A" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Service local" Foreground="#AEB8C5" />
          <TextBlock x:Name="ServiceState" Text="Connexion…" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Serveur NAS" Foreground="#AEB8C5" />
          <TextBlock x:Name="ServerState" Text="Non vérifié" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Profil joueur" Foreground="#AEB8C5" />
          <TextBlock x:Name="ProfileState" Text="Non configuré" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*" />
        <ColumnDefinition Width="1.35*" />
      </Grid.ColumnDefinitions>

      <Border Margin="0,0,9,0" Padding="20" BorderBrush="#303B48" BorderThickness="1" CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Ce PC" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="L’identité cryptographique est conservée par le service Windows dans une clé CNG machine non exportable."
                       TextWrapping="Wrap" Foreground="#AEB8C5" Margin="0,8,0,16" />

            <TextBlock Text="Nom du PC" />
            <TextBox x:Name="DeviceNameText" Margin="0,6,0,12" Padding="9" />

            <TextBlock Text="Pseudo Planet Crafter" />
            <TextBox x:Name="PlayerProfileText" Margin="0,6,0,12" Padding="9" />
            <TextBlock Text="Ce pseudo doit déjà exister dans chaque sauvegarde que vous voulez ouvrir. GameSave Hub refuse sinon le transfert."
                       TextWrapping="Wrap" Foreground="#D8A16E" Margin="0,0,0,12" />

            <TextBlock Text="Code d’invitation" />
            <TextBox x:Name="EnrollmentCodeText" Margin="0,6,0,12" Padding="9" />

            <WrapPanel>
              <Button x:Name="EnrollButton" Content="Associer ce PC" Click="Enroll_Click" Padding="14,9" Margin="0,0,8,8" />
              <Button x:Name="SavePlayerButton" Content="Enregistrer le pseudo" Click="SavePlayer_Click" Padding="14,9" Margin="0,0,8,8" />
            </WrapPanel>

            <Separator Margin="0,16" />
            <TextBlock Text="Sécurité locale" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="LocalGateText"
                       Text="Écriture WGS : désactivée"
                       Foreground="#9FD3A8"
                       Margin="0,8,0,0" />
            <TextBlock Text="Cette version peut lister et vérifier les mondes du NAS mais ne peut pas démarrer un import WGS, même si le feature gate serveur était ouvert."
                       TextWrapping="Wrap" Foreground="#AEB8C5" Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Margin="9,0,0,0" Padding="20" BorderBrush="#303B48" BorderThickness="1" CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="Mondes sur le NAS" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Left" />
              <Button Content="Charger la liste" Click="LoadWorlds_Click" Padding="12,7" DockPanel.Dock="Right" />
            </DockPanel>

            <TextBlock Text="Monde serveur" Margin="0,16,0,0" />
            <ComboBox x:Name="WorldComboBox" Margin="0,6,0,12" Padding="8" DisplayMemberPath="Label" />

            <WrapPanel>
              <Button x:Name="PreviewButton" Content="Vérifier la compatibilité" Click="Preview_Click" Padding="14,9" Margin="0,0,8,8" />
              <Button x:Name="TransferStartButton" Content="Démarrer le transfert" Click="TransferStart_Click" Padding="14,9" Margin="0,0,8,8" IsEnabled="False" />
            </WrapPanel>

            <Border Background="#19212A" Padding="14" CornerRadius="5" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Préflight" FontWeight="SemiBold" />
                <TextBlock x:Name="CompatibilityText" Text="Sélectionnez un monde puis lancez la vérification." TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="Joueurs présents dans la sauvegarde" FontWeight="SemiBold" Margin="0,16,0,6" />
            <TextBlock x:Name="PlayersText" Text="—" TextWrapping="Wrap" Foreground="#AEB8C5" />

            <TextBlock Text="Détails du monde" FontWeight="SemiBold" Margin="0,16,0,6" />
            <TextBlock x:Name="WorldDetailsText" Text="—" TextWrapping="Wrap" Foreground="#AEB8C5" />

            <Separator Margin="0,18" />
            <TextBlock Text="Orchestrateur" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="TransferStateText"
                       Text="Aucune session locale active."
                       TextWrapping="Wrap"
                       Foreground="#AEB8C5"
                       Margin="0,7,0,0" />
            <TextBlock Text="Les boutons de jeu/import seront activés dans la phase suivante, après validation de l’installation persistante et du préflight."
                       TextWrapping="Wrap" Foreground="#AEB8C5" Margin="0,7,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" x:Name="FeedbackText" Margin="0,18,0,0" Foreground="#AEB8C5" TextWrapping="Wrap" />
  </Grid>
</Window>
