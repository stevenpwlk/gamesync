<Window x:Class="GameSaveHub.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameSave Hub" Height="819.2" Width="1152" MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}"
        Foreground="{StaticResource TextPrimary}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="82" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Background="#FCFAF6" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <Grid Margin="34,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource TextPrimary}" Margin="0,0,14,0">
            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE774;" Foreground="White"
                       FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GameSave Hub" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="The Planet Crafter — monde partagé" Style="{StaticResource Muted}" FontSize="13" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="HealthDot" Width="10" Height="10" Fill="{StaticResource Success}" Margin="0,0,10,0" />
          <TextBlock x:Name="HealthText" Text="Connexion…" VerticalAlignment="Center" Margin="0,0,22,0" />
          <Rectangle Width="1" Height="28" Fill="{StaticResource Border}" Margin="0,0,10,0" />
          <Button x:Name="SettingsButton" Content="Réglages" Background="Transparent"
                  BorderBrush="Transparent" Padding="12,9"
                  AutomationProperties.Name="Réglages et diagnostics"
                  ToolTip="Réglages et diagnostics" Click="Settings_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid x:Name="HomePanel">
            <Grid.RowDefinitions>
              <RowDefinition Height="530" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ClipToBounds="True">
              <Image Source="Assets/planet-panorama.png" Stretch="UniformToFill" />
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#10FAF7F1" Offset="0" />
                    <GradientStop Color="#60FAF7F1" Offset="0.55" />
                    <GradientStop Color="#FFFAF7F1" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>

              <Grid Margin="64,26,64,18">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid MaxWidth="760" HorizontalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="1" Height="2" Background="#9CB1B7" VerticalAlignment="Center" />
                  <Border Grid.Column="3" Height="2" Background="#9CB1B7" VerticalAlignment="Center" />

                  <StackPanel Grid.Column="0">
                    <Border x:Name="StepOneCircle" Style="{StaticResource StepCircle}" Background="{StaticResource Success}">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" FontSize="31" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="StepOneText" Text="1. Monde prêt" FontWeight="SemiBold"
                               Foreground="{StaticResource Success}" HorizontalAlignment="Center" Margin="0,9,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Border x:Name="StepTwoCircle" Style="{StaticResource StepCircle}">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D4;" FontSize="29"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="StepTwoText" Text="2. Prise en main" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,9,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <Border x:Name="StepThreeCircle" Style="{StaticResource StepCircle}">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7FC;" FontSize="29"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="StepThreeText" Text="3. Jeu en cours" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,9,0,0" />
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                  <TextBlock x:Name="StateTitle" Text="Connexion au monde…" FontSize="39" FontWeight="Bold"
                             AutomationProperties.LiveSetting="Polite"
                             TextAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock x:Name="StateInstruction" Text="GameSave Hub vérifie la dernière sauvegarde."
                             Style="{StaticResource Muted}" FontSize="17" TextAlignment="Center"
                             HorizontalAlignment="Center" Margin="0,8,0,0" />
                  <Button x:Name="PrimaryButton" Content="Prendre la main" Style="{StaticResource PrimaryButton}"
                          Width="260" Foreground="White" HorizontalAlignment="Center"
                          Margin="0,22,0,0" Click="Primary_Click">
                    <Button.ContentTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                      </DataTemplate>
                    </Button.ContentTemplate>
                  </Button>
                  <ProgressBar x:Name="BusyBar" Width="260" Height="4" Margin="0,20,0,0"
                               IsIndeterminate="True" Visibility="Collapsed" />
                  <TextBlock x:Name="SafetyText" Text="Sauvegarde vérifiée et protégée"
                             Foreground="{StaticResource Success}" HorizontalAlignment="Center" Margin="0,13,0,0" />
                </StackPanel>
              </Grid>
            </Grid>

            <Border Grid.Row="1" Margin="34,0,34,30" Padding="28,22" Background="#D9FFFDF8"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,30,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" FontSize="19" Margin="0,0,11,0" />
                    <TextBlock Text="Activité récente" Style="{StaticResource SectionTitle}" />
                  </StackPanel>
                  <TextBlock x:Name="ActivityText" Text="Aucune activité récente à afficher."
                             Style="{StaticResource Muted}" Margin="0,16,0,0" />
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="{StaticResource Border}" />
                <StackPanel Grid.Column="2" Margin="30,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE716;" FontSize="19" Margin="0,0,11,0" />
                    <TextBlock Text="Monde partagé" Style="{StaticResource SectionTitle}" />
                  </StackPanel>
                  <TextBlock x:Name="WorldSummaryText" Text="Recherche du monde principal…"
                             Style="{StaticResource Muted}" Margin="0,16,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <Border x:Name="SetupPanel" Visibility="Collapsed" Background="{StaticResource Background}"
                  Padding="40" MinHeight="700">
            <Grid MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                      BorderThickness="1" CornerRadius="14" Padding="38">
                <StackPanel>
                  <TextBlock x:Name="SetupTitle" Text="Associons ce PC" FontSize="31" FontWeight="Bold" />
                  <TextBlock x:Name="SetupIntro" Text="Cette étape ne sera demandée qu'une fois."
                             Style="{StaticResource Muted}" FontSize="16" Margin="0,7,0,26" />
                  <StackPanel x:Name="DeviceFields">
                    <TextBlock Text="Nom de ce PC" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="DeviceNameText" Margin="0,0,0,16"
                             AutomationProperties.Name="Nom de ce PC" />
                  </StackPanel>
                  <TextBlock Text="Votre pseudo Planet Crafter" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBox x:Name="PlayerNameText" Margin="0,0,0,16"
                           AutomationProperties.Name="Pseudo Planet Crafter" />
                  <StackPanel x:Name="EnrollmentFields">
                    <TextBlock Text="Code d'invitation" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="EnrollmentCodeText" Margin="0,0,0,22"
                             AutomationProperties.Name="Code d'invitation" />
                  </StackPanel>
                  <Button x:Name="EnrollButton" Content="Continuer" Style="{StaticResource PrimaryButton}"
                          HorizontalAlignment="Stretch" Click="Enroll_Click" />
                  <Separator Margin="0,28,0,20" Background="{StaticResource Border}" />
                  <Button x:Name="DiagnosticButton" Content="Générer un rapport de diagnostic"
                          HorizontalAlignment="Left" Click="Diagnostic_Click" />
                  <TextBlock x:Name="FeedbackText" Style="{StaticResource Muted}" Margin="0,16,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
