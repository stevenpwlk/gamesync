<Window x:Class="GameSaveHub.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameSave Hub" Height="864" Width="1160" MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <Grid Margin="30,26,30,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- == En-tête == -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="GameSave Hub" FontSize="27" FontWeight="Bold" />
        <TextBlock Text="The Planet Crafter — partage de sauvegarde"
                   Style="{StaticResource Muted}" Margin="0,3,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="GateBadge" Background="#2E2417" BorderBrush="#5C4A2A" BorderThickness="1"
                Padding="12,7" CornerRadius="14" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="GateBadgeText" Text="ÉCRITURE DES SAUVEGARDES DÉSACTIVÉE"
                     Foreground="{StaticResource Warning}" FontWeight="SemiBold"
                     FontSize="11" TextWrapping="NoWrap" />
        </Border>
        <Button x:Name="RefreshButton" Content="Actualiser" Click="Refresh_Click" />
      </StackPanel>
    </Grid>

    <!-- Toujours présente, seule l'opacité change : la faire apparaître et disparaître
         décalerait verticalement toute la page à chaque rafraîchissement. -->
    <ProgressBar x:Name="BusyBar" Grid.Row="1" Margin="0,16,0,0"
                 IsIndeterminate="True" Opacity="0" />

    <!-- == Bandeau d'état == -->
    <Border Grid.Row="2" Margin="0,16,0,20" Padding="20,15"
            Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="SERVICE LOCAL" Style="{StaticResource Caption}" />
          <TextBlock x:Name="ServiceState" Text="Connexion…" FontSize="14"
                     FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Border}" Margin="20,2" />
        <StackPanel Grid.Column="2">
          <TextBlock Text="SERVEUR NAS" Style="{StaticResource Caption}" />
          <TextBlock x:Name="ServerState" Text="Non vérifié" FontSize="14"
                     FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
        <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Border}" Margin="20,2" />
        <StackPanel Grid.Column="4">
          <TextBlock Text="PROFIL JOUEUR" Style="{StaticResource Caption}" />
          <TextBlock x:Name="ProfileState" Text="Non configuré" FontSize="14"
                     FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
        <Rectangle Grid.Column="5" Width="1" Fill="{StaticResource Border}" Margin="20,2" />
        <StackPanel Grid.Column="6">
          <TextBlock Text="MODIFICATION DES SAUVEGARDES" Style="{StaticResource Caption}" />
          <TextBlock x:Name="LocalGateText" Text="Désactivée" FontSize="14"
                     Foreground="{StaticResource Success}" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- == Corps == -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Colonne gauche : ce PC -->
      <Border Style="{StaticResource Card}" Padding="20,18">
        <!-- Le padding droit dégage la barre de défilement, qui sinon recouvre le texte. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Ce PC" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Identité protégée par une clé Windows non exportable."
                       Style="{StaticResource Muted}" Margin="0,6,0,15" />

            <TextBlock Text="Nom du PC" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="DeviceNameText" Margin="0,0,0,13" />

            <TextBlock Text="Pseudo Planet Crafter" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PlayerProfileText" Margin="0,0,0,7" />
            <Border Background="#241D12" BorderBrush="#4A3B22" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,13">
              <TextBlock Text="Ce pseudo doit déjà exister dans la sauvegarde, sinon le transfert est refusé — pour ne jamais vous faire hériter du personnage d’un autre."
                         Foreground="{StaticResource Warning}" FontSize="11.5" />
            </Border>

            <TextBlock Text="Code d’invitation" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="EnrollmentCodeText" Margin="0,0,0,14" />

            <Button x:Name="EnrollButton" Content="Associer ce PC" Click="Enroll_Click"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                    Margin="0,0,0,8" />
            <Button x:Name="SavePlayerButton" Content="Enregistrer le pseudo" Click="SavePlayer_Click"
                    HorizontalAlignment="Stretch" />

            <!-- L'état du verrou vit dans le bandeau d'état ; il ne reste ici que sa
                 conséquence concrète pour le joueur. -->
            <TextBlock x:Name="LocalGateHelpText"
                       Text="Ce PC peut consulter et vérifier les mondes du NAS, mais pas écrire dans vos sauvegardes."
                       Style="{StaticResource Muted}" FontSize="11.5" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Colonne droite : assistant + catalogue -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="22">
          <StackPanel>

            <!-- Assistant : l'élément dominant, c'est lui qui pilote l'utilisateur -->
            <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource BorderStrong}"
                    BorderThickness="1" CornerRadius="8" Padding="22">
              <StackPanel>
                <TextBlock x:Name="WizardStepText" Style="{StaticResource Caption}"
                           Foreground="#4B9FE1" Visibility="Collapsed" Margin="0,0,0,7" />
                <TextBlock x:Name="WizardTitle" Text="Aucun transfert en cours"
                           FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="WizardInstruction"
                           Text="Sélectionnez un monde puis lancez la vérification de compatibilité."
                           Style="{StaticResource Muted}" Margin="0,9,0,0" />

                <!-- Le nom à recopier : seul endroit où une faute de frappe casse la séquence -->
                <Border x:Name="PlaceholderCard" Visibility="Collapsed" Margin="0,18,0,0"
                        Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource Warning}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                  <StackPanel>
                    <TextBlock Text="NOM À RECOPIER EXACTEMENT DANS LE JEU" Style="{StaticResource Caption}" />
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="PlaceholderText" Text="—" IsReadOnly="True"
                               FontFamily="Consolas" FontSize="23" FontWeight="Bold"
                               Foreground="{StaticResource Warning}" Background="Transparent"
                               BorderThickness="0" Padding="0" VerticalAlignment="Center" />
                      <Button x:Name="CopyPlaceholderButton" Grid.Column="1" Content="Copier"
                              Click="CopyPlaceholder_Click" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Sans espace avant ni après. Une différence d’un seul caractère fait échouer l’étape suivante."
                               Style="{StaticResource Muted}" FontSize="11.5" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>

                <ItemsControl x:Name="WizardSteps" Margin="0,18,0,0" Visibility="Collapsed">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="5" Height="5" Fill="#4B9FE1" VerticalAlignment="Top"
                                 Margin="2,7,11,0" />
                        <TextBlock Grid.Column="1" Text="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ProgressBar x:Name="WizardProgress" Margin="0,18,0,0"
                             IsIndeterminate="True" Visibility="Collapsed" />

                <TextBlock x:Name="WizardDetail" Visibility="Collapsed"
                           Foreground="{StaticResource Warning}" FontSize="12.5" Margin="0,14,0,0" />

                <WrapPanel x:Name="WizardActions" Margin="0,20,0,0">
                  <Button x:Name="WizardPrimaryButton" Content="Démarrer le transfert"
                          Click="WizardPrimary_Click" Style="{StaticResource PrimaryButton}"
                          Margin="0,0,10,0" Visibility="Collapsed" />
                  <Button x:Name="WizardAbortButton" Content="Abandonner"
                          Click="WizardAbort_Click" Margin="0,0,10,0" Visibility="Collapsed" />
                  <Button x:Name="DiagnosticReportButton" Content="Générer un rapport"
                          Click="DiagnosticReport_Click"
                          ToolTip="Crée sur le Bureau un fichier à envoyer en cas de problème. Ne contient aucune donnée de vos sauvegardes." />
                </WrapPanel>

                <!-- Résultat du dernier transfert. Une session peut s'achever pendant que
                     le joueur n'est pas devant l'écran : sans cette ligne il croirait que
                     rien ne s'est passé et recommencerait tout. -->
                <Border x:Name="LastOutcomeCard" Visibility="Collapsed" Margin="0,20,0,0"
                        Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource BorderStrong}"
                        BorderThickness="1" CornerRadius="6" Padding="14,11">
                  <TextBlock x:Name="LastOutcomeText" Style="{StaticResource Muted}" FontSize="12.5" />
                </Border>
              </StackPanel>
            </Border>

            <!-- Catalogue -->
            <StackPanel x:Name="CatalogPanel" Margin="0,24,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mondes sur le NAS" Style="{StaticResource SectionTitle}"
                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Button x:Name="LoadWorldsButton" Grid.Column="1" Content="Charger la liste"
                        Click="LoadWorlds_Click" Padding="13,8" />
              </Grid>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- ItemTemplate explicite plutôt que DisplayMemberPath : avec un
                     ControlTemplate personnalisé, la zone de sélection retombait sur
                     ToString() et affichait la structure interne de l'élément. -->
                <ComboBox x:Name="WorldComboBox" SelectionChanged="WorldComboBox_SelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="PreviewButton" Grid.Column="1" Content="Vérifier la compatibilité"
                        Click="Preview_Click" Margin="10,0,0,0" />
              </Grid>

              <Border Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource Border}"
                      BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="VÉRIFICATION DE COMPATIBILITÉ" Style="{StaticResource Caption}" />
                  <TextBlock x:Name="CompatibilityText"
                             Text="Sélectionnez un monde puis lancez la vérification."
                             Margin="0,7,0,0" />
                </StackPanel>
              </Border>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="JOUEURS DANS LA SAUVEGARDE" Style="{StaticResource Caption}" />
                  <TextBlock x:Name="PlayersText" Text="—" Style="{StaticResource Muted}"
                             Margin="0,8,0,0" LineHeight="21" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="DÉTAILS DU MONDE" Style="{StaticResource Caption}" />
                  <TextBlock x:Name="WorldDetailsText" Text="—" Style="{StaticResource Muted}"
                             Margin="0,8,0,0" LineHeight="21" />
                </StackPanel>
              </Grid>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- == Barre de message == -->
    <Border Grid.Row="4" Margin="0,18,0,0" Padding="15,11" CornerRadius="6"
            Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="1">
      <TextBlock x:Name="FeedbackText" Text="Prêt." Style="{StaticResource Muted}" />
    </Border>
  </Grid>
</Window>
