<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>GameSaveHub-Setup</AssemblyName>
    <!--
      Client.Service is a framework-dependent Exe (its own deployment is via the
      payload copy in Installer.cs, not via this reference's build output). MSBuild's
      NETSDK1150 check refuses a self-contained Exe referencing a non-self-contained
      Exe project; this reference exists only so the solution's dependency graph
      builds Client.Service before Setup, not to consume its assembly. Disabling the
      check here is the documented escape hatch (see the NETSDK1150 message / aka.ms/netsdk1150).
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <ProjectReference Include="..\GameSaveHub.Contracts\GameSaveHub.Contracts.csproj" />
    <ProjectReference Include="..\GameSaveHub.Client.Orchestration\GameSaveHub.Client.Orchestration.csproj" />
    <ProjectReference Include="..\GameSaveHub.Client.Service\GameSaveHub.Client.Service.csproj" />
  </ItemGroup>
</Project>
