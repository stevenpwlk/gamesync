<Window x:Class="GameSaveHub.Client.Probe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameSave Hub Probe" Height="650" Width="840" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen" Background="#12161C" Foreground="#F3F5F7">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="GameSave Hub" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Text="Probe — diagnostic Planet Crafter Game Pass" FontSize="16" Foreground="#AEB8C5" Margin="0,4,0,0" />
      <TextBlock Text="Cet outil ne modifie jamais WGS. L’envoi est manuel : rien ne quitte ce PC sans votre accord."
                 Foreground="#D7A06F" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,16">
      <Button x:Name="AnalyzeButton" Content="1. Analyser ce PC" Click="Analyze_Click"
              Padding="18,10" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
      <TextBlock x:Name="StateText" Text="En attente" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#AEB8C5" />
    </StackPanel>

    <TextBox Grid.Row="2" x:Name="ReportText" IsReadOnly="True" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="14"
             Background="#1B222B" Foreground="#E8EDF2" BorderBrush="#303A46" />

    <Border Grid.Row="3" Margin="0,16,0,0" Padding="14" BorderBrush="#303A46" BorderThickness="1" CornerRadius="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Rapport à transmettre" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
            <TextBlock Text="Monde jetable :" VerticalAlignment="Center" />
            <ComboBox x:Name="WorldCombo" Width="230" Margin="10,0,0,0" IsEnabled="False"
                      DisplayMemberPath="DisplayName" />
          </StackPanel>
          <CheckBox x:Name="IncludeArtifactCheck" Margin="0,10,0,0" IsEnabled="False"
                    Content="Je confirme que ce monde est jetable et j’inclus sa sauvegarde dans le rapport." />
        </StackPanel>
        <Button Grid.Column="1" x:Name="ExportButton" Content="2. Créer le rapport…" Click="Export_Click"
                IsEnabled="False" Padding="18,10" Margin="18,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
