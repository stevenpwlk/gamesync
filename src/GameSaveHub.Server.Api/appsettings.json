{
  "ConnectionStrings": {
    "GameSaveHub": "Data Source=data/gamesavehub.db;Cache=Shared;Pooling=True"
  },
  "Storage": {
    "Root": "data",
    "MaxArtifactBytes": 67108864,
    "MaxChunkBytes": 4194304
  },
  "FeatureGates": {
    "AllowHostTransfer": false
  },
  "ClientCompatibility": {
    "MinimumAcquireVersion": ""
  },
  "Authentication": {
    "Issuer": "GameSaveHub",
    "Audience": "GameSaveHub.Client",
    "SigningKey": "REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
