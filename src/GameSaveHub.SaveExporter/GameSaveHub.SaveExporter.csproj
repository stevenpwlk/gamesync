<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>GameSaveHub.SaveExporter</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSaveHub.SaveExporter.Core\GameSaveHub.SaveExporter.Core.csproj" />
    <ProjectReference Include="..\GameSaveHub.Adapters.PlanetCrafter.GamePass\GameSaveHub.Adapters.PlanetCrafter.GamePass.csproj" />
  </ItemGroup>
</Project>
