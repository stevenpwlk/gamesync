<Window x:Class="GameSaveHub.SaveExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exporter une sauvegarde The Planet Crafter"
        Width="760"
        Height="650"
        MinWidth="620"
        MinHeight="520"
        Background="#F4EFE3"
        Foreground="{StaticResource InkBrush}"
        Loaded="Window_Loaded">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Choisissez la partie à envoyer" />
    <TextBlock Grid.Row="1"
               Margin="0,8,0,20"
               MaxWidth="680"
               HorizontalAlignment="Left"
               FontSize="15"
               TextWrapping="Wrap"
               Text="Fermez The Planet Crafter, sélectionnez la bonne sauvegarde puis choisissez un dossier. Aucun fichier du jeu ne sera modifié." />

    <ListBox x:Name="WorldList"
             Grid.Row="2"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="WorldList_SelectionChanged">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="18" Background="{StaticResource SurfaceBrush}" BorderBrush="#D8D0C0" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding DisplayName}" />
              <TextBlock Margin="0,5,0,0" Foreground="#596273">
                <Run Text="Modifiée le " />
                <Run Text="{Binding LastModifiedAtUtc, StringFormat={}{0:dd/MM/yyyy à HH:mm}}" />
                <Run Text=" · Mode " />
                <Run Text="{Binding Mode, TargetNullValue=inconnu}" />
              </TextBlock>
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="#39465D">
                      <Run FontWeight="SemiBold" Text="{Binding Name}" />
                      <Run Text=" · " />
                      <Run Text="{Binding RoleLabel, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="StatusText"
               Grid.Row="3"
               Margin="0,14,0,12"
               FontSize="14"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"
               Text="Recherche des sauvegardes…" />

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="RefreshButton"
              Padding="18,10"
              Click="Refresh_Click"
              Content="Actualiser" />
      <Button x:Name="ExportButton"
              Grid.Column="1"
              Padding="22,12"
              Margin="12,0,0,0"
              Background="{StaticResource AccentBrush}"
              Foreground="White"
              FontWeight="SemiBold"
              IsEnabled="False"
              Click="Export_Click"
              Content="Exporter cette sauvegarde" />
    </Grid>
  </Grid>
</Window>
